# Backend sub-server (boemi-api). Dev: http://localhost:4700 · Prod: /api (di-proxy nginx)
BOEMI_API_URL=http://localhost:4700

# Supabase (Auth Email/Google di FE). Data katalog kini via boemi-api, bukan langsung.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (server-only, untuk admin panel & seed) — JANGAN diekspos ke client
SUPABASE_SERVICE_ROLE_KEY=

# Email PEMILIK panel (comma). Tidak bisa dihapus lewat panel — jaring pengaman
# supaya /admin tidak mungkin terkunci. Staf lain dikelola di /admin/pengguna.
# KOSONG = TIDAK ADA yang bisa masuk /admin (fail-closed, disengaja).
ADMIN_EMAILS=

# Payment gateway — Xendit (Invoice API). Ambil dari dashboard Xendit.
# XENDIT_SECRET_KEY=          Settings → API Keys (secret key)
# XENDIT_CALLBACK_TOKEN=      Settings → Webhooks (Verification Token)
# URL webhook yang didaftarkan: https://www.boeminusantara.com/pembayaran/xendit

# Notifikasi email (Resend). Tanpa ini, pesanan baru tidak mengirim email.
# RESEND_API_KEY=
# NOTIFY_FROM=Boemi Nusantara <info@boeminusantara.com>

# Tombol "Masuk dengan Google" hanya muncul kalau provider-nya dinyalakan di Supabase.
# NEXT_PUBLIC_GOOGLE_LOGIN=true

# Content generator (fitur nanti)
# MAGIN_API_URL=
# MAGIN_API_KEY=

# PPN (11 atau 12) — configurable, konfirmasi akunting client
NEXT_PUBLIC_PPN_RATE=11
